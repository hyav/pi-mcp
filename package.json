{
  "name": "@hyav/pi-mcp",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyav/pi-mcp.git"
  },
  "description": "MCP Gateway for Pi — stdio/SSE/Streamable HTTP transports, session recovery, connection pooling, structured error handling.",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "mcp",
    "model-context-protocol",
    "mcp-client"
  ],
  "author": "hyav",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && npm run typecheck",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "artifact:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run audit:runtime && npm run audit:all && npm run release:check && npm run check && npm test && npm run artifact:check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.20.1",
    "tsx": "4.23.11",
    "typebox": "1.3.11",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "src/",
    "index.ts",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/hyav/pi-mcp#readme",
  "bugs": {
    "url": "https://github.com/hyav/pi-mcp/issues"
  }
}
